# Copy this file to .env.local for local development and fill in the values.
# Find them in Supabase: your project → "Connect" button (top of the dashboard) → App Frameworks → Next.js.
# On Vercel, add the same names under Project → Settings → Environment Variables.
#
# These two values are safe to expose in the browser; your data is protected by
# the Row Level Security rules in supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Never put the "secret" / "service_role" key in a NEXT_PUBLIC_ variable or commit it to git.

# Optional: shows a "Contact" button for organizers and a report address on /guidelines.
# NEXT_PUBLIC_SUPPORT_EMAIL=hello@example.com

# Optional: Google Maps browser key (venue search, maps, distances). See supabase/README.md.
# Restrict it to your website and to: Maps JavaScript API, Places API (New), Maps Embed API.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
